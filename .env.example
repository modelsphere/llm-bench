# Copy to .env for `docker compose up` (docker-compose.yml). Never commit .env.
# Generate each secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

SECRET_KEY=
# Fernet key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_SECRET_KEY=
POSTGRES_PASSWORD=

ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: the API key LLM AutoTune authenticates with (give it the same value).
# Must start with llmb_ — e.g. echo "llmb_$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')"
SERVICE_API_KEY=

# LLMBENCH_PORT=8080
# WORKER_PROCESSES=2
