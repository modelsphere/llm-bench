# The .env file `docker compose up` reads. Easiest: let the script write it —
#   scripts/gen-prod-secrets.sh --env            (add --service-key for LLM AutoTune)
# or copy this file to .env and fill in the values. Never commit .env.
#
# Each secret: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
SECRET_KEY=
# A Fernet key (keep the trailing '='): openssl rand -base64 32 | tr '+/' '-_'
PLATFORM_SECRET_KEY=
POSTGRES_PASSWORD=

ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: the API key LLM AutoTune authenticates with (give it the same value).
# Must start with llmb_ — e.g. echo "llmb_$(openssl rand -hex 24)"
SERVICE_API_KEY=

# LLMBENCH_VERSION=0.2.0       # the released images to run
# LLMBENCH_PORT=8080
# WORKER_PROCESSES=2
