# Datasets are fetched or mounted, never committed: the academic sets are
# gigabytes (scripts/fetch_academic_datasets.py downloads them) and captured
# traffic is somebody's customers' prompts. The tiny, hand-written examples the
# modules default to live in bench/examples/ instead.
dataset/
*.gz

submit*.yaml

# Frontend build output and dependencies — both regenerated by
# platform/frontend/Dockerfile (npm ci && npm run build).
platform/frontend/dist/
platform/frontend/node_modules/
*.tsbuildinfo

# Real credentials. Generate with scripts/gen-prod-secrets.sh; the example
# file is the one that is meant to be read.
deploy/helm/llm-bench/secrets.yaml
secrets.prod.yaml
secrets.*.yaml
!deploy/helm/llm-bench/secrets.example.yaml
.env
*.kubeconfig

# Helm-rendered debugging artifact (regenerate with `helm template`).
manifests.yaml

